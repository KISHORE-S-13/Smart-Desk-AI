# SmartDesk AI - Backend Environment Template
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Database configuration: defaults to local SQLite if left empty
# For PostgreSQL (Neon, Supabase, AWS RDS, Vercel Postgres):
# DATABASE_URL=postgresql://username:password@hostname:5432/smartdesk_db
DATABASE_URL=

# Security & Session
SECRET_KEY=smartdesk-enterprise-secret-key-change-in-production
JWT_SECRET_KEY=smartdesk-jwt-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=*

# Port (optional, defaults to 5000)
PORT=5000
